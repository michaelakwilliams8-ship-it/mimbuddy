{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/__l5e/:path*",
      "destination": "https://create-joy-blocks.lovable.app/__l5e/:path*"
    }
  ],
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.mimbuddy.com.au" }], "destination": "https://mimbuddy.com.au/:path*", "permanent": true },
    { "source": "/hospitals", "destination": "/", "permanent": true }
  ]
}
