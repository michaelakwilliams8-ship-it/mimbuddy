{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/hospitals",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/__l5e/:path*",
      "destination": "https://create-joy-blocks.lovable.app/__l5e/:path*"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
